{
  "name": "gitcai",
  "version": "1.0.0",
  "description": "AI-powered Git commit message generator CLI for Conventional Commits using Ollama or Gemini",
  "main": "./dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "commit",
    "commit-message",
    "ai",
    "cli",
    "conventional-commits",
    "ollama",
    "gemini",
    "developer-tools"
  ],
  "homepage": "https://github.com/VanChung369/gitcai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanChung369/gitcai.git"
  },
  "bugs": {
    "url": "https://github.com/VanChung369/gitcai/issues"
  },
  "license": "MIT",
  "author": "VanChung369",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "gitcai": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "test": "yarn build && node --test",
    "prepack": "yarn build",
    "prepublishOnly": "yarn build",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "ora": "^9.4.0",
    "simple-git": "^3.36.0"
  }
}
